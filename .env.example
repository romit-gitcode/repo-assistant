GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DATABASE_URL=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional MCP overrides.
# Defaults:
# - filesystem MCP disabled for connected GitHub repos
# - GitHub MCP command: Docker official image ghcr.io/github/github-mcp-server
# Set MCP_FILESYSTEM_ROOT only when it points to a local checkout of the selected repo.
MCP_FILESYSTEM_ROOT=
MCP_GITHUB_COMMAND=
MCP_GITHUB_ARGS=
MCP_GITHUB_TOOLSETS=default
